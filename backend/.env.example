PORT=4000
# Local:  mongodb://127.0.0.1:27017/school_db
# Atlas:  mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/school_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/school_db
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=8h
# Your frontend address (set once the frontend is deployed). Leave empty in development.
FRONTEND_URL=
# Used only by `npm run db:seed` (a random password is generated if left empty)
ADMIN_EMAIL=admin@school.test
ADMIN_PASSWORD=
